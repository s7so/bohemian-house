rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Projects: anyone can read, only authenticated admins can write
    match /projects/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Services: anyone can read, only authenticated admins can write
    match /services/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Testimonials: anyone can read, only authenticated admins can write
    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact messages: anyone can create, only authenticated admins can read/update/delete
    match /messages/{document=**} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
